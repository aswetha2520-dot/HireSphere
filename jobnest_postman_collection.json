            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"candidate@jobnest.com\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login", ""]
            }
          }
        },
        {
          "name": "4. Login (Employer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.tokens && jsonData.tokens.access) {",
                  "    pm.collectionVariables.set('employerAccessToken', jsonData.tokens.access);",
                  "    pm.collectionVariables.set('refreshToken', jsonData.tokens.refresh);",
                  "    console.log('Employer token updated!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"employer@techcorp.com\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login", ""]
            }
          }
        },
        {
          "name": "5. Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.tokens && jsonData.tokens.access) {",
                  "    pm.collectionVariables.set('adminAccessToken', jsonData.tokens.access);",
                  "    pm.collectionVariables.set('refreshToken', jsonData.tokens.refresh);",
                  "    console.log('Admin token updated!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@jobnest.com\",\n  \"password\": \"AdminPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login", ""]
            }
          }
        },
        {
          "name": "6. Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access) {",
                  "    pm.collectionVariables.set('candidateAccessToken', jsonData.access);",
                  "    console.log('Access token renewed successfully!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/token/refresh/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "token", "refresh", ""]
            }
          }
        },
        {
          "name": "7. Logout (Blacklist Token)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{candidateAccessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout", ""]
            }
          }
        },
        {
          "name": "8. Get Current User (Me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{candidateAccessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me", ""]
            }
          }
        },
        {
          "name": "9. Update User Info (Me)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{candidateAccessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Alexander\",\n  \"last_name\": \"Morgan\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/me/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me", ""]
            }
          }
        },
        {
          "name": "10. Change Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{candidateAccessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"old_password\": \"SecurePass123!\",\n  \"new_password\": \"NewSecretPass2026!\",\n  \"new_password_confirm\": \"NewSecretPass2026!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/change-password/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "change-password", ""]
            }
          }
        }
      ]
    },
    {
      "name": "2. Profile Management",
      "item": [
