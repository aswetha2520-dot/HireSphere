    {
      "name": "3. Job Management",
      "item": [
        {
          "name": "1. Browse Public Active Jobs",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/jobs/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jobs", ""]
            }
          }
        },
        {
          "name": "2. Search & Filter Jobs",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/jobs/?search=Django&remote_status=REMOTE&employment_type=FULL_TIME",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jobs", ""],
              "query": [
                { "key": "search", "value": "Django" },
                { "key": "remote_status", "value": "REMOTE" },
                { "key": "employment_type", "value": "FULL_TIME" }
              ]
            }
          }
        },
        {
          "name": "3. Create Job (Employer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set('jobId', jsonData.id.toString());",
                  "    console.log('Job ID automatically saved:', jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{employerAccessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Senior Django Backend Engineer\",\n  \"description\": \"We are looking for a senior backend engineer to lead our core API services.\",\n  \"responsibilities\": \"Architect REST APIs, design database schemas, write unit and integration tests.\",\n  \"required_skills\": \"Python, Django, Django REST Framework, PostgreSQL, Docker\",\n  \"qualifications\": \"4+ years of backend engineering experience\",\n  \"employment_type\": \"FULL_TIME\",\n  \"experience_level\": \"SENIOR\",\n  \"salary_min\": \"120000.00\",\n  \"salary_max\": \"155000.00\",\n  \"location\": \"San Francisco, CA\",\n  \"remote_status\": \"REMOTE\",\n  \"number_of_openings\": 2,\n  \"application_deadline\": \"2026-12-31\",\n  \"is_active\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/jobs/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jobs", ""]
            }
          }
        },
        {
          "name": "4. Get Job Details",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/jobs/{{jobId}}/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jobs", "{{jobId}}", ""]
            }
          }
        },
        {
          "name": "5. Update Job (Employer)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{employerAccessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"salary_max\": \"165000.00\",\n  \"number_of_openings\": 3\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/jobs/{{jobId}}/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jobs", "{{jobId}}", ""]
            }
          }
        },
        {
          "name": "6. Delete Job (Employer)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{employerAccessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/jobs/{{jobId}}/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jobs", "{{jobId}}", ""]
            }
          }
        }
      ]
    },
    {
      "name": "4. Job Applications",
      "item": [
        {
          "name": "1. Submit Job Application (Candidate)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set('applicationId', jsonData.id.toString());",
                  "    console.log('Application ID saved:', jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{candidateAccessToken}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "job", "value": "{{jobId}}", "type": "text" },
                { "key": "cover_letter", "value": "I am thrilled to apply for this position. My background in Python/Django aligns directly with your mission.", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/applications/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "applications", ""]
            }
          }
        },
        {
          "name": "2. List Applications (Role Filtered)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{candidateAccessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/applications/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "applications", ""]
            }
          }
        },
        {
          "name": "3. Get Application Details",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{candidateAccessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/applications/{{applicationId}}/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "applications", "{{applicationId}}", ""]
            }
          }
        },
        {
          "name": "4. Withdraw Application (Candidate)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{candidateAccessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"WITHDRAWN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/applications/{{applicationId}}/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "applications", "{{applicationId}}", ""]
            }
          }
        },
        {
          "name": "5. Update Application Status (Employer)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{employerAccessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"INTERVIEW\",\n  \"employer_notes\": \"Passed initial code evaluation. Scheduled for architectural system interview.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/applications/{{applicationId}}/status/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "applications", "{{applicationId}}", "status", ""]
            }
          }
        },
        {
          "name": "6. Get Applications for Specific Job (Employer)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{employerAccessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/jobs/{{jobId}}/applications/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jobs", "{{jobId}}", "applications", ""]
            }
          }
        },
        {
          "name": "7. Cancel Pending Application (Candidate)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{candidateAccessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/applications/{{applicationId}}/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "applications", "{{applicationId}}", ""]
            }
          }
        }
      ]
