{
  "info": {
    "name": "JobNest Backend API Collection",
    "_postman_id": "jobnest-backend-api-v1",
    "description": "Complete Postman collection for JobNest Job Portal REST API including Admin, Employer, and Candidate authentication, profiles, jobs CRUD, and application workflow with automated token capture.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "candidateAccessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "employerAccessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminAccessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "jobId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "applicationId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "1. Register Candidate",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.tokens && jsonData.tokens.access) {",
                  "    pm.collectionVariables.set('candidateAccessToken', jsonData.tokens.access);",
                  "    pm.collectionVariables.set('refreshToken', jsonData.tokens.refresh);",
                  "    console.log('Candidate token automatically saved!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"candidate@jobnest.com\",\n  \"password\": \"SecurePass123!\",\n  \"password_confirm\": \"SecurePass123!\",\n  \"role\": \"CANDIDATE\",\n  \"first_name\": \"Alex\",\n  \"last_name\": \"Morgan\",\n  \"full_name\": \"Alex Morgan\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register", ""]
            }
          }
        },
        {
          "name": "2. Register Employer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.tokens && jsonData.tokens.access) {",
                  "    pm.collectionVariables.set('employerAccessToken', jsonData.tokens.access);",
                  "    pm.collectionVariables.set('refreshToken', jsonData.tokens.refresh);",
                  "    console.log('Employer token automatically saved!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"employer@techcorp.com\",\n  \"password\": \"SecurePass123!\",\n  \"password_confirm\": \"SecurePass123!\",\n  \"role\": \"EMPLOYER\",\n  \"first_name\": \"Sarah\",\n  \"last_name\": \"Connor\",\n  \"company_name\": \"TechCorp Global\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register", ""]
            }
          }
        },
        {
