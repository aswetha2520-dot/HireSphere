                { "key": "experience", "value": "3 years backend engineering in SaaS", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/candidates/me/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "candidates", "me", ""]
